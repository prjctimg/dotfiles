{
  "name": "tree-sitter-gray",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Grayscale programming language",
  "main": "bindings/node",
  "keywords": [
    "parser",
    "tree-sitter",
    "gray"
  ],
  "author": "Marshall Burns",
  "license": "MIT",
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.3"
  },
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.gray",
      "file-types": [
        "gray"
      ],
      "injection-regex": "^gray$"
    }
  ]
}
