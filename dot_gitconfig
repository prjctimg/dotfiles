[user]
	email = prjctimg@outlook.com
	name = prjctimg
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	di = diff
	dc = diff --cached
	ds = diff --staged
	lg = log --oneline --graph --decorate
	lol = log --oneline --graph --all --decorate
	rs = restore
	rh = reset HEAD
	rhh = reset --hard HEAD
	unstage = restore --staged
	last = log -1 HEAD
	ss = status -s
	sb = status -sb
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	pf = push --force-with-lease
	pl = pull --rebase
	psup = push -u origin HEAD
	gcam = commit -am
	gcan = commit --amend --no-edit
	gsur = submodule update --recursive --remote
	pr = "!gh pr"
	iss = "!gh issue"
	repo = "!gh repo"
	web = "!gh repo view --web"
[core]
	excludesfile = ~/.gitignore_global
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[status]
	short = true
