{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode"],
  "modules-center": [],
  "modules-right": ["network", "bluetooth", "battery", "pulseaudio", "custom/settings", "cpu", "memory", "clock", "tray", "custom/power"],

  "custom/launcher": {
    "format": "APPS",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "sway/mode": {
    "format": "{}",
    "max-length": 30
  },

  "network": {
    "format-wifi": "📶 {essid}",
    "format-ethernet": "🌐 {ifname}",
    "format-disconnected": "📴",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "/usr/sbin/wl-control-panel.sh",
    "interval": 5
  },

  "bluetooth": {
    "format": "🔵 {status}",
    "format-disabled": "⚪",
    "format-connected": "🔵 {device_name}",
    "on-click": "blueman-manager"
  },

  "battery": {
    "format": "🔋 {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "format-plugged": "🔌 {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "interval": 30
  },

  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇 MUTED",
    "format-source": "🎤 {volume}%",
    "format-source-muted": "🎤 OFF",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5
  },

  "custom/settings": {
    "format": "⚙️",
    "tooltip": "Settings",
    "on-click": "/usr/sbin/wl-control-panel.sh"
  },

  "cpu": {
    "format": "🖥️ {usage}%",
    "interval": 3
  },

  "memory": {
    "format": "💾 {percentage}%",
    "interval": 5
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "{:%A, %B %d %Y}",
    "on-click": "swaymsg workspace number 1"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "custom/power": {
    "format": "🔴 POWER",
    "tooltip": false,
    "on-click": "/root/.config/sway/scripts/power-menu.sh"
  }
}
